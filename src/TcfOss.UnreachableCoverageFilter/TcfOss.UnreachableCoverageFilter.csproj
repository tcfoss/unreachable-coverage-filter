<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <_IsWindowsTarget Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win'))">true</_IsWindowsTarget>
        <_IsWindowsTarget Condition="'$(RuntimeIdentifier)' == '' AND '$(OS)' == 'Windows_NT'">true</_IsWindowsTarget>
        <_IsWindowsTarget Condition="'$(_IsWindowsTarget)' == ''">false</_IsWindowsTarget>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Hosting" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>
    <Target Name="GenerateBuildInfo" AfterTargets="MinVer" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
            <BuildContent>
namespace $(RootNamespace)
{
    public static class BuildInfo
    {
        public const string Date = "$(BuildDate) UTC"%3B
        public const string Version = "$(Version)"%3B
        public const string InformationalVersion = "$(InformationalVersion)"%3B
    }
}
            </BuildContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.cs" Lines="$(BuildContent)" Overwrite="true" />
    </Target>

    <ItemGroup>
        <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(_IsWindowsTarget)' == 'true'">
        <None Update="ninman.win.yml" Link="ninman.yml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="'$(_IsWindowsTarget)' != 'true'">
        <None Update="ninman.yml" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>